# .env.example — kopieer naar .env en vul in
# Nooit .env committen naar git!

# PostgreSQL verbinding (productie op Hetzner)
DATABASE_URL=postgresql://chatbot_user:wachtwoord@localhost/chatbot_db

# Brevo SMTP (https://app.brevo.com → SMTP & API → SMTP)
BREVO_SMTP_LOGIN=jouw@email.com
BREVO_SMTP_KEY=xsmtpsib-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Verzendadres — display name is de bedrijfsnaam, domein indiqa.nl
BREVO_FROM=Veldman Hoveniers <noreply@indiqa.nl>

# Ontvanger offerte-notificaties (eigen e-mailadres hovenier)
NOTIFY_TO=info@veldmanhoveniers.nl

# Flask beveiliging
SECRET_KEY=verander-dit-naar-een-willekeurige-lange-string

# Tenant
TENANT_SLUG=veldmanhoveniers
BASE_URL=https://www.veldmanhoveniers.nl
